---
import BaseLayout from '../layouts/BaseLayout.astro';
import DictionaryTable from '../components/DictionaryTable.astro';
import { getAllDictionaries, getAllDomains } from '../lib/db';

const all = getAllDictionaries();
const domains = getAllDomains();
const totalTerms = all.reduce((sum, d) => sum + d.term_count, 0);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="arabterm">
  <section class="hero">
    <h1>قاموس المصطلحات التقنية</h1>
    <p class="lead">
      مجموعة منسّقة من القواميس العربية / الإنجليزية / الفرنسية، تضمّ
      <strong>{all.length}</strong> قاموساً و
      <strong>{totalTerms}</strong> مصطلحاً.
    </p>
  </section>

  <div class="banner">
    <div class="banner-text">
      <strong>هل تبحث عن مُصطلَح مُحدَّد؟</strong>
      ابحث في المدونة كاملةً عن معنى وتصريف أي مصطلح
    </div>
    <a class="btn-primary" href="https://wikitermbase.toolforge.org/" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      ابدأ البحث
    </a>
  </div>

  <p class="muted small">
    مرتّبة حسب الأحدث إضافةً. انقر على ترويسة العمود لإعادة الترتيب، أو على مجالٍ لعرض قواميسه وحدها.
  </p>
  <DictionaryTable dictionaries={all} domains={domains} base={base} />
</BaseLayout>
