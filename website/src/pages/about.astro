---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllDictionaries, getAllDomains } from '../lib/db';

const base = import.meta.env.BASE_URL;

// Computed from arabterm.db at build time, so the page never goes stale.
const dictionaries = getAllDictionaries();
const totalTerms = dictionaries.reduce((sum, d) => sum + d.term_count, 0);
const totalDomains = getAllDomains().length;
const withScan = dictionaries.filter((d) => d.archive_org_url).length;
const withWikidata = dictionaries.filter((d) => d.wikidata_id).length;

const repo = 'https://github.com/forzagreen/arabterm';
const wtb = 'https://wikitermbase.toolforge.org/';
---
<BaseLayout title="عن المشروع" description="نبذة عن مشروع arabterm وقاعدة بياناته متعددة اللغات.">
  <h1>عن مشروع arabterm</h1>

  <p>
    <strong>arabterm</strong> قاعدة بيانات مفتوحة تجمع معاجم مصطلحية عربية متعدّدة اللغات
    (عربي / إنجليزي / فرنسي): <strong>{dictionaries.length}</strong> من المعاجم
    و<strong>{totalTerms}</strong> من المصطلحات، موزّعة على <strong>{totalDomains}</strong> من المجالات.
    وهي المصدر الذي تُبنى منه قاعدة بيانات
    <a href={wtb} target="_blank" rel="noopener">مسرد الويكي</a>،
    محرّك البحث الذي يخدم توحيد المصطلحات في ويكيبيديا العربية.
  </p>

  <h2>البدايات</h2>
  <p>
    بدأ المشروع سنة 2022 باستخراج معاجم موقع
    <a href="https://www.arabterm.org/" target="_blank" rel="noopener">arabterm.org</a>
    (معاجم تقنية مرتّبة حسب المجالات والقطاعات)، ثم اتّسع ليشمل معاجم أخرى من مصادر متعدّدة:
    المعاجم الموحّدة ومسارد الألكسو التي يصدرها <em>مكتب تنسيق التعريب</em>، و<em>المعجم الطبي الموحّد</em>،
    ومعاجم مجمع اللغة العربية بدمشق والمجمع الأردني ومجمع الملك سلمان العالمي للغة العربية،
    و<em>المورد الحديث</em>، و<em>Agrovoc</em>، و<em>Electropedia</em>، وغيرها.
  </p>

  <h2>ما يقدّمه هذا الموقع</h2>
  <ul>
    <li>صفحة لكلّ معجم، فيها مصطلحاته كاملة مقسّمة على صفحات، مع ملف JSON للتنزيل.</li>
    <li>
      مجال أو أكثر لكلّ معجم (رياضيات، طب، قانون…)، يُعرض وسوماً في الصفحة الرئيسية
      ويمكن حصر القائمة في مجال واحد.
    </li>
    <li>
      رابط إلى النسخة المصوّرة على archive.org لـ<strong>{withScan}</strong> من المعاجم:
      رقم الصفحة بجانب المصطلح يفتح صفحته في الكتاب الأصلي.
    </li>
    <li>
      تعريف لكلّ معجم في <a href="https://www.wikidata.org/" target="_blank" rel="noopener">ويكي بيانات</a>
      ({withWikidata} من {dictionaries.length})، ومنها تؤخذ مجالاته.
    </li>
    <li>زرّ «الجديد» في الأعلى يعرض المعاجم والميزات التي أُضيفت منذ زيارتك الأخيرة.</li>
  </ul>
  <p>
    البحث في المصطلحات ليس هنا، بل في <a href={wtb} target="_blank" rel="noopener">مسرد الويكي</a>:
    بحث موحّد في كلّ المعاجم، مع ترشيح الترجمة الأكثر شيوعاً ورمز استشهاد جاهز لويكيبيديا.
  </p>

  <h2>أدوات التحليل اللغوي</h2>
  <p>
    arabterm ومسرد الويكي جزء من
    <a href={`${wtb}tools`} target="_blank" rel="noopener">«أدوات التحليل اللغوي»</a>،
    منظومة مفتوحة المصدر لحوسبة اللغة العربية تعمل على ثلاثة مستويات، وتصبّ كلّها في مشاريع ويكيميديا
    (ويكي بيانات وويكاموس وويكيبيديا):
  </p>
  <ul>
    <li>
      <strong>المستوى الصرفي</strong> — محلّل صرفي يعطي جذر الكلمة ووزنها
      (<a href="https://forzagreen.github.io/farahidi-js/" target="_blank" rel="noopener">الفراهيدي</a>)،
      ومصرّف للأفعال
      (<a href="https://forzagreen.github.io/mazini-js/" target="_blank" rel="noopener">المازني</a>)،
      وجداول لتصريف الأفعال وجموع التكسير.
    </li>
    <li>
      <strong>المستوى الدلالي</strong> — أداة
      <a href="https://ar-senses.toolforge.org/" target="_blank" rel="noopener">مراجعة المعاني</a>
      التي تنشر معاني الأفعال في ويكي بيانات وويكاموس.
    </li>
    <li>
      <strong>المستوى المعجمي</strong> — مسرد الويكي، وهذه القاعدة، وأداة تقترح ألفاظاً عربية
      لمصطلح أجنبي باشتقاقها من الجذور والأوزان
      (<a href="https://genar.waeltellat.com/" target="_blank" rel="noopener">توليد الكلمات العربية</a>)،
      وأداة لمراجعة المعاجم المقروءة آلياً بمقابلة كلّ مدخل بصورة صفحته
      (<a href="https://review.waeltellat.com/" target="_blank" rel="noopener">مراجعة المعاجم</a>):
      المعجم الذي تكتمل مراجعته يُنشر هنا.
    </li>
  </ul>

  <h2>التنزيلات</h2>
  <ul>
    <li>
      قاعدة SQLite كاملة:
      <a href={`${repo}/raw/main/arabterm.db.gz`} target="_blank" rel="noopener">arabterm.db.gz</a>
      (تُفكّ بالأمر <code dir="ltr">gunzip</code>)
    </li>
    <li>
      ملفات SQL لـ SQLite و MariaDB:
      <a href={`${repo}/raw/main/db/sqlite/arabterm.sql.gz`} target="_blank" rel="noopener">db/sqlite/arabterm.sql.gz</a>
      و
      <a href={`${repo}/raw/main/db/mariadb/arabterm.sql.gz`} target="_blank" rel="noopener">db/mariadb/arabterm.sql.gz</a>
    </li>
    <li>ملف JSON لكلّ معجم: من زرّ «تنزيل JSON» في صفحته.</li>
    <li>
      مجموعة بيانات بصيغة Parquet على Hugging Face، تُحدَّث آلياً مع كلّ تغيير:
      <a href="https://huggingface.co/datasets/forzagreen/arabterm" target="_blank" rel="noopener">🤗 forzagreen/arabterm</a>
      — تُحمَّل في بايثون بسطر واحد:
      <code dir="ltr">load_dataset("forzagreen/arabterm")</code>
    </li>
  </ul>

  <h2>الترخيص والاستشهاد</h2>
  <p>
    البيانات منشورة بترخيص
    <a href="https://creativecommons.org/licenses/by/4.0/deed.ar" target="_blank" rel="noopener">المشاع الإبداعي، النسبة 4.0 (CC BY 4.0)</a>.
    عند استعمالها، يُرجى الاستشهاد بالمستودع (زرّ «Cite this repository» على GitHub)
    وذكر المعجم الذي أُخذ منه المصطلح.
  </p>

  <h2>المصدر والمساهمة</h2>
  <p>
    المشروع مفتوح المصدر على <a href={repo} target="_blank" rel="noopener">GitHub</a>.
    لاقتراح معجم أو الإبلاغ عن خطأ في مصطلح، افتح
    <a href={`${repo}/issues`} target="_blank" rel="noopener">Issue</a> أو Pull Request.
  </p>

  <p class="small muted">
    <a href={base}>← مُجمَل المعاجم</a>
  </p>
</BaseLayout>
