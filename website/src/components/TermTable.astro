---
import { scanPageUrl, type Dictionary, type Term, type TermColumns } from '../lib/db';

interface Props {
  terms: Term[];
  startIndex: number; // 1-based index of first row on this page
  cols: TermColumns;
  // Page numbers link to the dictionary's archive.org scan, when it has one.
  scan: Pick<Dictionary, 'archive_org_url' | 'page_offset'>;
}

const { terms, startIndex, cols, scan } = Astro.props;
---
<div class="table-wrap">
  <table class="terms">
    <thead>
      <tr>
        <th class="col-id">#</th>
        {cols.arabic && <th>العربية</th>}
        {cols.english && <th lang="en" dir="ltr">English</th>}
        {cols.french && <th lang="fr" dir="ltr">Français</th>}
        {cols.description && <th>التعريف</th>}
        {cols.page && <th class="col-page">الصفحة</th>}
        {cols.uri && <th class="col-uri"><span class="visually-hidden">المصدر</span></th>}
      </tr>
    </thead>
    <tbody>
      {terms.map((t, i) => {
        const pageUrl = scanPageUrl(scan, t.page);
        return (
          <tr>
            <td class="id">{startIndex + i}</td>
            {cols.arabic && <td lang="ar" dir="rtl">{t.arabic ?? ''}</td>}
            {cols.english && <td lang="en" dir="ltr">{t.english ?? ''}</td>}
            {cols.french && <td lang="fr" dir="ltr">{t.french ?? ''}</td>}
            {cols.description && <td class="desc">{t.description ?? ''}</td>}
            {cols.page && (
              <td class="page">
                {pageUrl ? (
                  <a href={pageUrl} target="_blank" rel="noopener" title="الصفحة في النسخة المصوّرة (archive.org)">{t.page}</a>
                ) : (t.page ?? '')}
              </td>
            )}
            {cols.uri && (
              <td class="uri">
                {t.uri && (
                  <a class="ext" href={t.uri} target="_blank" rel="noopener" aria-label="المصدر"></a>
                )}
              </td>
            )}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
